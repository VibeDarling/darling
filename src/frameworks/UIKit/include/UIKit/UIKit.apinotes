- Name: UIControlContentVerticalAlignment
  SwiftName: UIControl.ContentVerticalAlignment
- Name: UIControlEvents
  SwiftName: UIControl.Event
- Name: UIControlState
  SwiftName: UIControl.State
- Name: UIDatePickerMode
