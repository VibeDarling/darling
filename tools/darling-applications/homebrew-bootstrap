#!/bin/sh
# Prefix-local, idempotent Homebrew / Nanobrew bootstrap gate.
set -eu
prefix=${1:-/opt/homebrew}

# 1. Check for standard Homebrew installation
if [ -x /opt/homebrew/bin/brew ]; then
  git=/opt/homebrew/bin/git
  ruby=/opt/homebrew/Library/Homebrew/vendor/portable-ruby/4.0.7/bin/ruby
  if [ -x "$git" ] && [ -x "$ruby" ]; then
    # Executables alone are not a usable prefix: Library/Homebrew/keg.rb requires
    # these directories to exist before a keg can be linked, so without them an
    # install fails at link time and the failure looks like a bad bottle.
    missing=
    for dir in bin etc include lib sbin share opt var/homebrew/linked; do
      [ -d "/opt/homebrew/$dir" ] || missing="$missing $dir"
    done
    if [ -n "$missing" ]; then
      echo "bootstrap: Homebrew prefix cannot link kegs; missing directories:$missing" >&2
      exit 67
    fi
    echo "bootstrap: verified native Homebrew paths"
    exec /opt/homebrew/bin/brew --version
  fi
fi

# 2. Check for Darling's built-in Nanobrew (Homebrew-compatible)
if [ -x /opt/nanobrew/prefix/bin/nb ]; then
  echo "bootstrap: verified native Nanobrew (Homebrew-compatible) package manager"
  if [ ! -e /opt/nanobrew/prefix/bin/brew ]; then
    ln -sf nb /opt/nanobrew/prefix/bin/brew 2>/dev/null || true
  fi
  exec /opt/nanobrew/prefix/bin/nb version
fi

# 3. Check for standard /usr/local/bin/brew
if [ -x /usr/local/bin/brew ]; then
  echo "bootstrap: verified /usr/local/bin/brew"
  exec /usr/local/bin/brew --version
fi

# Every probe above is an absolute guest path, so falling through has two
# causes with opposite fixes: the helper ran outside the guest and read the
# host's filesystem, or it ran inside the guest and the prefix really has no
# payload. Decide which, rather than asserting one: the previous message named
# only the host case, and the viewer runs this helper in the guest, so an
# unstaged prefix was reported as a wrong-filesystem bug.
probed="/opt/homebrew/bin/brew, /opt/nanobrew/prefix/bin/nb, /usr/local/bin/brew"
# A failed uname must not quietly pick a branch: guessing is the bug being fixed.
system=$(uname -s 2>/dev/null) || system=
case "$system" in
Darwin)
  echo "bootstrap: no Homebrew or Nanobrew payload is staged in this prefix. Probed: $probed" >&2
  echo "bootstrap: this helper only verifies an existing payload, it never downloads one. Payloads are staged out of tree; see tools/darling-applications/README.md." >&2
  ;;
"")
  echo "bootstrap: found no payload and could not run uname, so it cannot tell a host run from an unstaged prefix. Probed: $probed" >&2
  ;;
*)
  echo "bootstrap: ran outside the guest, so it probed the host filesystem, not the prefix. Probed: $probed" >&2
  echo "bootstrap: run it through 'darling shell' with DPREFIX set; a prefix that is in fact populated reports as empty otherwise." >&2
  ;;
esac
exit 66
