#!/bin/sh
# Guest-side Brewfile gate; casks target the guest /Applications directory.
set -eu
file=${1:?Brewfile path required}
mas_skip=${2:-}
[ "${file#/}" = "$file" ] && exit 64
[ -f "$file" ] || { echo "Brewfile not found: $file" >&2; exit 66; }
if [ -n "$mas_skip" ]; then export HOMEBREW_BUNDLE_MAS_SKIP="$mas_skip"; fi
export HOMEBREW_CASK_OPTS="--appdir=/Applications"
exec /opt/homebrew/bin/brew bundle --file "$file"
